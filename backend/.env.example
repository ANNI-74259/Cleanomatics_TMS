# Copy this file to ".env" and change the values if needed.
# NEVER commit the real ".env" file to GitHub.

# Port where the API runs
PORT=5000

# development | production
NODE_ENV=development

# Frontend URL(s) allowed to call this API (CORS).
# For more than one URL, separate them with a comma.
CLIENT_URL=http://localhost:5173

# Rate limit: max requests per IP in a time window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Add a few sample tasks when the server starts (true | false)
SEED_SAMPLE_DATA=true
